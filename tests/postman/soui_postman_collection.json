                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/journal/1/grade",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "journal", "1", "grade"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Выставить некорректную оценку (Негативный 61 балл)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Отказ валидации - Ошибка 422 или 400\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 422, 500]);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"grade\": 61,\n    \"submission_date\": \"2026-05-20\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/journal/1/grade",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "journal", "1", "grade"]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
