{
    "info": {
        "_postman_id": "3b29c9ef-871d-4876-b684-bc4882b5fae5",
        "name": "СОУИ API - QA Sandbox Collection",
        "description": "Коллекция API-запросов для Системы Обработки Учебной Информации (СОУИ). Содержит примеры позитивных и негативных проверок (вкл. покрытие баг-репортов, найденных AI-агентом).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Специальности (Specialties)",
            "item": [
                {
                    "name": "Получить список специальностей",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус код 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Ответ является массивом\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/specialties",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "specialties"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Создать новую специальность (Позитивный)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Генерируем уникальный код ТОЛЬКО из кириллицы (без цифр!)",
                                    "var letters = 'АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЭЮЯ';",
                                    "var code = 'ПМАТ';",
                                    "for (var i = 0; i < 3; i++) {",
                                    "    code += letters[Math.floor(Math.random() * letters.length)];",
                                    "}",
                                    "pm.variables.set('test_code', code);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус код 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Проверка структуры созданной специальности\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('specialty_id');",
                                    "    pm.expect(jsonData.name).to.eql(\"Прикладная математика\");",
                                    "    pm.expect(jsonData.code_spec).to.eql(pm.variables.get('test_code'));",
                                    "    pm.expect(jsonData.faculty_id).to.eql(1);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Прикладная математика\",\n    \"code_spec\": \"{{test_code}}\",\n    \"faculty_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/specialties",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "specialties"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Попытка создать специальность с латиницей (Негативный)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус код 400 или 422 Bad Request\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                                    "});",
                                    "",
                                    "pm.test(\"Информативное сообщение об ошибке валидации\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(JSON.stringify(jsonData)).to.match(/нарушение|целостности|кириллица/i);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Informatics\",\n    \"code_spec\": \"ИНФ\",\n    \"faculty_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/specialties",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "specialties"]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "2. Студенты (Students)",
            "item": [
                {
                    "name": "Получить список студентов",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус код 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/students?sort_by=last_name",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "students"],
                            "query": [
                                {
                                    "key": "sort_by",
                                    "value": "last_name"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "BUG-002: Попытка создать студента с двойной фамилией (Дефис)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Отказ БД - Статус 422 или 500\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([422, 500, 400]);",
                                    "});",
                                    "",
                                    "pm.test(\"Проверка, что запрос отклонен из-за Regex ограничения\", function () {",
                                    "    var responseStr = pm.response.text();",
                                    "    pm.expect(responseStr.toLowerCase()).to.match(/ошибка целостности|недопустимые символы|дубликат/i);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"last_name\": \"Салтыкова-Щедрина\",\n    \"first_name\": \"Анна\",\n    \"middle_name\": \"Сергеевна\",\n    \"student_card_number\": 888999,\n    \"education_form\": \"бюджетное\",\n    \"group_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/students",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "students"]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "3. Журнал успеваемости (Journal)",
            "item": [
                {
                    "name": "Фиксация сдачи работы и выставление оценки (Граница 45)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус код 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
