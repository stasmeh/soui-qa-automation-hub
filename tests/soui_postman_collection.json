{
	"info": {
		"_postman_id": "3b29c9ef-871d-4876-b684-bc4882b5fae5",
		"name": "СОУИ API - QA Sandbox Collection",
		"description": "Коллекция API-запросов для Системы Обработки Учебной Информации (СОУИ). Содержит примеры позитивных и негативных проверок с авто-тестами на JavaScript.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Специальности (Specialties)",
			"item": [
				{
					"name": "Получить список специальностей",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Ответ является массивом\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/specialties",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"specialties"
							]
						}
					},
					"response": []
				},
				{
					"name": "Создать новую специальность (Позитивный)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Проверка структуры созданной специальности\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('specialty_id');",
									"    pm.expect(jsonData.name).to.eql(\"Прикладная математика\");",
									"    pm.expect(jsonData.code_spec).to.eql(\"ПМАТ\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Прикладная математика\",\n    \"code_spec\": \"ПМАТ\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/specialties",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"specialties"
							]
						}
					},
					"response": []
				},
				{
					"name": "Попытка создать специальность с латиницей (Негативный)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Информативное сообщение об ошибке валидации\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include(\"допустима только кириллица\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Informatics\",\n    \"code_spec\": \"ИНФ\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/specialties",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"specialties"
							]
						}
					},
					"response": []
				}
			]
		},
