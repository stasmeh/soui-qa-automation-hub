		{
			"name": "3. Журнал успеваемости (Journal)",
			"item": [
				{
					"name": "Фиксация сдачи работы и выставление оценки (Граница 45)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200 OK либо 404 если запись не существует\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"grade\": 45,\n    \"submission_date\": \"2026-05-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/journal/1/grade",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
